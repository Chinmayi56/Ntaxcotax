# Copy this file to .env and adjust values as needed.

MONGO_URL=mongodb://localhost:27017
DB_NAME=ntaxco

JWT_SECRET=change_this_to_a_long_random_secret

# Optional first-admin provisioning. If unset, create/provision the admin through your deployment process.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# NEVER enable this in production. It inserts the legacy demo datasets.
NTAXCO_ENABLE_DEMO_SEED=false

# Comma-separated list of frontend origins allowed to call this API.
# Must exactly match the URL (scheme + host + port) the frontend runs on
# — no trailing slash, no wildcards. If unset, the backend defaults to the
# local dev origins above and logs a warning; PRODUCTION MUST set this
# explicitly to the deployed frontend's exact URL, e.g.:
#   CORS_ORIGINS=https://your-frontend-domain.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# In addition to the exact list above, the backend also allows any LAN
# origin (192.168.x.x / 10.x.x.x / 172.16-31.x.x / localhost) on ports
# 3000, 3001 or 3002 by default — this is what lets you open the
# frontend via its "Network" IP during local dev without editing this
# file every time your IP changes. Set CORS_ORIGIN_REGEX to override
# that pattern; leave unset to keep the safe default.
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}):(3000|3001)$

# Most hosting platforms (Render, Railway, Heroku, etc.) assign the port
# to listen on via a $PORT env var at runtime — the Procfile in this
# folder already reads it (falls back to 8001 if unset, e.g. for local
# dev). You normally don't need to set PORT yourself; the platform does.

# Real Razorpay payment verification. Required for online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required for Mobile OTP login — real SMS OTP via Twilio Verify.
# Get these from https://console.twilio.com (Account) and
# https://console.twilio.com/us1/develop/verify/services (Verify Service).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
